      "xl": "20px",
      "pill": "999px"
    },
    "font": {
      "sans": "Inter, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif",
      "mono": "ui-monospace, 'SF Mono', Menlo, monospace"
    },
    "text": {
      "xs": "12px",
      "sm": "13px",
      "base": "15px",
      "md": "16px",
      "lg": "18px",
      "xl": "22px",
      "2xl": "28px"
    },
    "shadow": {
      "sm": "0 1px 2px rgba(15,23,42,0.05)",
