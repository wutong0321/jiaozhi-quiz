      "nav": "0 12px 32px rgba(124,58,237,0.16)"
    }
  },
  "semantic": {
    "color-primary": "{color.violet-600}",
    "color-on-primary": "{color.white}",
    "color-secondary": "{color.violet-500}",
    "color-accent": "{color.emerald-600}",
    "color-on-accent": "{color.white}",
    "color-background": "{color.violet-50}",
    "color-foreground": "{color.slate-900}",
    "color-card": "{color.white}",
    "color-muted": "{color.violet-100}",
    "color-muted-foreground": "{color.slate-600}",
    "color-border": "{color.violet-100-border}",
    "color-destructive": "{color.red-600}",
    "color-success": "{color.emerald-600}",
    "color-warning": "{color.amber-500}",
    "color-ring": "{color.violet-600}",
    "space-page": "{space.4}",
    "space-card": "{space.5}",
    "space-stack": "{space.3}",
    "radius-card": "{radius.lg}",
    "radius-control": "{radius.md}",
