    "card-bg": "{semantic.color-card}",
    "card-border": "{semantic.color-border}",
    "card-radius": "{semantic.radius-card}",
    "card-shadow": "{primitive.shadow.sm}",
    "option-bg": "{semantic.color-card}",
    "option-border": "{semantic.color-border}",
    "option-selected-bg": "{primitive.color.violet-100}",
    "option-selected-border": "{semantic.color-primary}",
    "option-correct-bg": "#E8F8F0",
    "option-wrong-bg": "#FEECEC",
